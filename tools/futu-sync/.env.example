# Copy this file to .env and fill in your values. Never commit .env.
HOLDR_URL=https://holdr.lol
HOLDR_SYNC_TOKEN=paste-your-sync-token-here
# MD5 of your Futu trade password (printf %s 'pwd' | md5sum). Required for REAL accounts.
FUTU_TRADE_PWD_MD5=
# Optional overrides:
# FUTU_HOST=127.0.0.1
# FUTU_PORT=11111
# FUTU_ACC_ID=
# HISTORY_DAYS=365
