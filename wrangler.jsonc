{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "holdr",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets",
    "not_found_handling": "none"
  },
  // D1 database for the portfolio. Create it once in the Cloudflare dashboard
  // (Workers & Pages → D1 → Create, name it "stonk-go-db"), then paste its
  // database ID below. Until then, `wrangler deploy` will fail validation.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stonk-go-db",
      "database_id": "4fdd0409-3f3b-44c6-9212-384bd1e94a55"
    }
  ],
  // Workers AI for portfolio insights (no key needed; billed to the account).
  "ai": { "binding": "AI" },
  // Plain-text vars MUST live here: `wrangler deploy` wipes dashboard
  // variables that aren't declared in this file (secrets survive).
  "vars": {
    "NEXTAUTH_URL": "https://holdr.lol",
    "NEXT_PUBLIC_VAPID_PUBLIC_KEY": "BIHiUEt9NafaXBHq3mHrYrUSg-0QTbHve5EraPilxUx1tTBoLks8Ud4j-23PNIY1YsuftoNqOIDs2PQ"
  },
  // Cron trigger for background push notification checks (every 15 min).
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
,
  // Custom domain for the hectorchan.com subdomain (keeper domain; .lol may expire).
  // `wrangler deploy` creates the Custom Domain + manages DNS on deploy.
  // holdr.lol stays dashboard-managed and untouched.
  "routes": [{ "pattern": "holdr.hectorchan.com", "custom_domain": true }]
}
