// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    // Needed for the D1 driver adapter used on Cloudflare Workers
    // (src/server/db.ts switches to D1 when the DB binding is present).
    previewFeatures = ["driverAdapters"]
}

datasource db {
    provider = "sqlite"
    // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
    // Further reading:
    // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
    // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
    url      = env("DATABASE_URL")
}

// NOTE: SQLite has no enum type, so Transaction.type is a plain String
// constrained to "BUY" | "SELL" by zod validation in the tRPC router.

// A position in a single ticker. Derived from the transaction log
// (recomputed on every buy/sell/delete) so the log stays the source of truth.
model Holding {
    id       String @id @default(cuid())
    symbol   String @unique // normalized, e.g. "AAPL"
    name     String? // company name, filled from the quote feed when known
    quantity Float
    avgCost  Float // average cost basis per share (fees folded in)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([symbol])
}

// Immutable log of every buy/sell. Holdings are recomputed from this table,
// so deleting or editing a transaction automatically fixes the position.
// Rows with source="ibkr" are imported from IBKR Flex syncs (deduplicated by
// externalId) — they merge broker activity into the same log and cost basis.
model Transaction {
    id         String @id @default(cuid())
    symbol     String // normalized, e.g. "AAPL"
    type       String // "BUY" | "SELL" (validated by zod; sqlite has no enums)
    quantity   Float
    price      Float // price per share at execution
    fees       Float           @default(0)
    executedAt DateTime        @default(now())
    note       String?
    // "manual" | "ibkr" — where this row came from.
    source     String  @default("manual")
    // Stable IBKR trade key ("ibkr:<transactionID>") for idempotent imports.
    // Null for manual rows.
    externalId String? @unique

    createdAt DateTime @default(now())

    @@index([symbol])
    @@index([executedAt])
}

// Snapshot of positions synced from Interactive Brokers via the
// Flex Web Service (read-only). Refreshed by ibkr.sync; the same sync merges
// the Flex trades into the Transaction log, which stays the source of truth
// for holdings and cost basis.
model BrokerPosition {
    id            String   @id @default(cuid())
    accountId     String
    symbol        String
    description   String?
    assetCategory String // "STK" | "OPT" | "FUT" | "CASH" | ...
    currency      String
    quantity      Float
    markPrice     Float?
    costBasisPrice Float? // per-share cost basis from the broker (IBKR Flex); null when the broker doesn't report it
    syncedAt      DateTime @default(now())

    @@index([accountId])
    @@index([symbol])
}

// Trade executions synced from IBKR Flex (Trades section).
// The Flex report for the query's date range is the full history;
// sync replaces the whole set, like BrokerPosition.
model BrokerTrade {
    id              String   @id @default(cuid())
    accountId       String
    symbol          String
    description     String?
    assetCategory   String
    currency        String
    tradeDate       String // YYYYMMDD as IBKR reports it
    quantity        Float
    tradePrice      Float?
    proceeds        Float?
    commission      Float?
    realizedPnl     Float?
    openClose       String?
    transactionType String?
    syncedAt        DateTime @default(now())

    @@index([symbol])
    @@index([tradeDate])
}

// Cash movements synced from IBKR Flex (Cash Transactions section):
// dividends, interest, withholding tax, deposits/withdrawals, fees.
model BrokerCashFlow {
    id          String   @id @default(cuid())
    accountId   String
    symbol      String?
    description String?
    currency    String
    dateTime    String
    amount      Float
    type        String
    syncedAt    DateTime @default(now())

    @@index([type])
}

// Necessary for NextAuth
model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String? // @db.Text
    access_token             String? // @db.Text
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String? // @db.Text
    session_state            String?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id            String    @id @default(cuid())
    name          String?
    email         String?   @unique
    emailVerified DateTime?
    image         String?
    accounts      Account[]
    sessions      Session[]
    brokerCredential BrokerCredential?
    exchangeCredentials ExchangeCredential[]
    exchangeBalances ExchangeBalance[]
    exchangeSyncs ExchangeSync[]
    syncTokens    SyncToken[]
}

// Per-user IBKR Flex credentials, AES-GCM encrypted (see src/server/crypto.ts).
// The server only ever decrypts them transiently to run a sync; the IBKR
// snapshot itself is never written to shared tables for logged-in users.
model BrokerCredential {
    id         String   @id @default(cuid())
    userId     String   @unique
    encToken   String
    encQueryId String
    iv         String
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt
    user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Per-user read-only API credentials for crypto exchanges (Coinbase,
// Binance), AES-GCM encrypted (see src/server/crypto.ts — encKey/encSecret
// reuse the same two-field encrypted shape as BrokerCredential).
// The server only ever decrypts them transiently to run a sync.
model ExchangeCredential {
    id         String   @id @default(cuid())
    userId     String
    exchange   String   // "coinbase" | "binance"
    label      String?
    encKey     String
    encSecret  String
    iv         String
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt
    user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, exchange])
    @@index([userId])
}

// Per-user crypto exchange balances. Native quantities are stored as EXACT
// decimal strings (never floats); valueCents is integer USD cents as text.
// priceUsd/priceSource/priceAt record which spot price produced the value.
model ExchangeBalance {
    id          String   @id @default(cuid())
    userId      String
    exchange    String   // "coinbase" | "binance"
    asset       String   // "BTC"
    quantity    String   // exact native decimal string, e.g. "0.05"
    priceUsd    String?  // exact decimal string, null when unpriced
    priceSource String?  // e.g. "binance:ticker/price:BTCUSDT"
    priceAt     String?  // ISO timestamp of the price fetch
    valueCents  String?  // integer USD cents as text, null when unpriced
    currency    String   @default("USD")
    // Real cost basis: average cost in USD from the account's actual spot
    // trade history (Binance myTrades), exact decimal string. Null when the
    // cost is unknowable (no trade history — e.g. transferred in). Never
    // estimated: unknown stays null so P/L can't silently fake it.
    avgCostUsd     String?
    costTradeCount Int?   // how many real fills avgCostUsd was computed from
    syncedAt    DateTime @default(now())
    user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, exchange, asset])
    @@index([userId, exchange])
}

// One row per exchange sync: totals + reconciliation outcome, so the
// dashboard can show the last sync state without re-hitting the exchange.
model ExchangeSync {
    id          String   @id @default(cuid())
    userId      String
    exchange    String   // "coinbase" | "binance"
    syncedAt    DateTime @default(now())
    assetCount  Int
    pricedCount Int
    totalCents  String   // integer USD cents as text (sum of per-row values)
    driftCents  String   // totalCents - round(sum of unrounded values); 0 when clean
    ok          Boolean  // false when |drift| exceeds the rounding bound
    note        String?
    user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, exchange])
}

// Long-lived bearer tokens for local sync agents (e.g. the Futu OpenD
// sync script in tools/futu-sync). Only the SHA-256 hash is stored — the
// plaintext token is shown once at creation and never again. Single-purpose
// scopes ("futu:ingest"); revocable by the owner at any time.
model SyncToken {
    id         String    @id @default(cuid())
    userId     String
    name       String
    tokenHash  String    @unique // SHA-256 hex of the bearer token
    scope      String    // "futu:ingest"
    createdAt  DateTime  @default(now())
    lastUsedAt DateTime?
    revokedAt  DateTime?
    user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

// Daily portfolio snapshot for the equity-curve chart. Recorded client-side
// (once per day on dashboard load) because broker positions live in the
// browser's IBKR snapshot, not on the server.
model PortfolioSnapshot {
    id            String   @id @default(cuid())
    date          String   @unique // YYYY-MM-DD (local date)
    marketValue   Float
    costBasis     Float
    totalPL       Float?
    dayPL         Float?
    holdingsCount Int      @default(0)
    createdAt     DateTime @default(now())
}

// Price alerts: email the owner when a symbol crosses their target.
// Alerts require login — the account email is where the alert goes.
model PriceAlert {
    id          String    @id @default(cuid())
    userId      String
    email       String // denormalized from the account at creation (the check endpoint has no session)
    symbol      String
    targetPrice Float
    direction   String // "above" | "below"
    active      Boolean   @default(true)
    triggeredAt DateTime?
    lastPrice   Float?
    createdAt   DateTime  @default(now())

    @@index([userId])
    @@index([active])
}

// Web Push subscriptions for browser notifications.
model PushSubscription {
    id        String   @id @default(cuid())
    endpoint  String   @unique
    p256dh    String
    auth      String
    createdAt DateTime @default(now())

    @@index([endpoint])
}

// Yahoo historical daily bars: price-history cache for the true value curve.
// Read-through: the curve builder reads D1 first, fetches only missing days
// from Yahoo, and upserts them back. Prices are TEXT (no float).
model YahooDailyBar {
    symbol    String
    date      String   // YYYY-MM-DD (trading day, UTC)
    close     String   // exact decimal string
    adjclose  String?
    fetchedAt DateTime @default(now())

    @@id([symbol, date])
    @@index([symbol, date])
}
